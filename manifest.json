{
  "manifest_version": 3,
  "name": "Insights Plus for Apify",
  "short_name": "Insights+",
  "version": "1.0.0",
  "description": "Date ranges, per-Actor breakdowns and account-wide tables for Apify Console Insights, plus run and user stats on Store pages.",
  "author": "Devansh Tiwari",
  "homepage_url": "https://github.com/Devansh-365/apify-insights-plus",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Insights Plus for Apify",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://console.apify.com/*"
      ],
      "js": [
        "content/token-sniffer.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://console.apify.com/*"
      ],
      "js": [
        "lib/error-boundary.js",
        "lib/perf.js",
        "lib/context.js",
        "lib/features.js",
        "lib/local-store.js",
        "lib/format.js",
        "lib/range.js",
        "lib/analytics-export.js",
        "lib/actor-detail.js",
        "lib/profile-sort.js",
        "lib/visibility.js",
        "lib/actor-filter.js",
        "lib/benchmark.js",
        "lib/portfolio.js",
        "lib/quality-inbox.js",
        "lib/acquisition-triage.js",
        "lib/today.js",
        "lib/api.js",
        "lib/cache.js",
        "lib/insights-nav.js",
        "content/app.js",
        "content/actor-picker.js",
        "content/range.js",
        "content/portfolio.js",
        "content/quality-inbox.js",
        "content/today.js",
        "content/quality.js",
        "content/acquisition-triage.js",
        "content/acquisition.js",
        "content/debugging.js",
        "content/actor-detail.js",
        "content/profile-sort.js",
        "content/visibility.js",
        "content/benchmark.js"
      ],
      "css": [
        "content/app.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://apify.com/*",
        "https://www.apify.com/*"
      ],
      "js": [
        "lib/error-boundary.js",
        "lib/perf.js",
        "lib/context.js",
        "lib/features.js",
        "lib/local-store.js",
        "lib/format.js",
        "lib/actor-detail.js",
        "lib/profile-sort.js",
        "lib/benchmark.js",
        "lib/api.js",
        "lib/cache.js",
        "content/actor-detail.js",
        "content/profile-sort.js",
        "content/benchmark.js"
      ],
      "css": [
        "content/app.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
